PORT=3000
JWT_SECRET=replace_with_a_strong_secret
SESSION_TTL_SECONDS=600
EASYQR_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
EASYQR_PROJECT_KEYS=dev_project:dev_key
EASYQR_STORAGE_BACKEND=memory
DATABASE_URL=postgres://easyqr:easyqr@localhost:5432/easyqr
EASYQR_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
EASYQR_REDIS_CHANNEL=easyqr.events
EASYQR_INSTANCE_ID=easyqr-local-1
EASYQR_ADMIN_TOKEN=change_me_admin_token
EASYQR_ALLOW_LEGACY_KEYS=true

# Wave 3 rate limit config scaffolding (logic not yet enabled in runtime handlers)
EASYQR_RATE_LIMIT_ENABLED=true
# Max API requests per minute per project
EASYQR_RATE_LIMIT_API_PROJECT_PER_MIN=60
# Max API requests per minute per IP
EASYQR_RATE_LIMIT_API_IP_PER_MIN=120
# Max WS handshakes per minute per project
EASYQR_RATE_LIMIT_WS_PROJECT_PER_MIN=30
# Max WS handshakes per minute per IP
EASYQR_RATE_LIMIT_WS_IP_PER_MIN=60
